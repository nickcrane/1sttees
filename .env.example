# Copy to .env and fill in. Never commit .env itself (see .gitignore).
# Fields marked (Phase N) aren't read by any code yet -- they're documented
# here now per the project's CONFIG spec, validated loosely by lib/env.ts
# until the phase that wires them up tightens the check. See docs/decisions.md.

NODE_ENV=development

# --- Core infra (Phase 0) ---
DATABASE_URL=postgresql://1stees:1stees@localhost:5432/1stees
REDIS_URL=redis://localhost:6379

# --- AliExpress Open Platform DS API (Phase 1) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_CALLBACK_URL=
ALIEXPRESS_GATEWAY_URL=https://api-sg.aliexpress.com
# AES-256-GCM key for encrypting the stored OAuth access/refresh token.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# fixture (default, no credentials needed, what CI runs) | live
ALIEXPRESS_MODE=fixture
ALIEXPRESS_FIXTURES_DIR=./fixtures/aliexpress
ALIEXPRESS_TARGET_CURRENCY=GBP
ALIEXPRESS_TARGET_LANGUAGE=en_US
ALIEXPRESS_SHIP_TO_COUNTRY=GB
ALIEXPRESS_MIN_REQUEST_INTERVAL_MS=1000
ALIEXPRESS_MAX_RETRIES=5
ALIEXPRESS_BACKOFF_BASE_MS=1000
ALIEXPRESS_BACKOFF_MAX_MS=60000

# --- Stripe (Phase 3) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects back to after an off-site step (e.g. an SCA
# challenge). No trailing slash.
STORE_BASE_URL=http://localhost:3000

# --- PayPal (Phase 3) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# --- Cart (Phase 3) ---
# HMAC key for the guest-cart cookie. Generate with: openssl rand -base64 32
CART_COOKIE_SECRET=

# --- Admin auth (Phase 2 -- needed to gate the admin import UI) ---
# Generate with: openssl rand -base64 32
ADMIN_AUTH_SECRET=
# Comma-separated allowlist -- an admin account can only be created/signed
# into for an email on this list.
ADMIN_EMAILS=
# Shown in the authenticator app during TOTP enrollment.
ADMIN_TOTP_ISSUER=1st Tees Admin

# --- Auth.js / customer realm (Phase 3.5) ---
# Google OAuth only -- no customer password. Generate CUSTOMER_AUTH_SECRET
# with: openssl rand -base64 32. GOOGLE_CLIENT_ID/SECRET come from a Google
# Cloud Console OAuth client (redirect URI:
# <STORE_BASE_URL>/api/auth/customer/callback/google).
AUTH_SECRET=
CUSTOMER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_SOCIAL_LOGIN=false
AUTH_RATE_LIMIT_PER_MIN=10

# --- Email / observability (Phase 3.5+) ---
RESEND_API_KEY=
SENTRY_DSN=

# --- Store / VAT / pricing config ---
STORE_CURRENCY=GBP
VAT_MODE=NOT_REGISTERED
VAT_NUMBER=
ORDER_HOLD_MINUTES=30
MIN_MARGIN_PCT=20
PRICE_DRIFT_TOLERANCE_PCT=10
FX_BUFFER_PCT=3
# Stripe UK card rate as of writing -- tune if the actual rate differs.
PAYMENT_PROCESSING_PCT=1.5
PAYMENT_PROCESSING_FIXED_PENCE=20
# Not specified by the business -- a conservative starting estimate for a
# cheap, low-return-rate product line. Tune once real return data exists.
RETURNS_RESERVE_PCT=2
