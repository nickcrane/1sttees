generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma migrate dev` has something to migrate and
// Phase 0's "hello store" page has something to read. Replaced by the real
// domain model in Phase 2.
model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

// The AliExpress OAuth token, singleton row (id is always "default").
// access/refresh token values are AES-256-GCM encrypted at rest (see
// lib/aliexpress/crypto.ts) -- never stored or logged in plaintext.
model AliExpressToken {
  id                  String   @id @default("default")
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt           DateTime
  refreshExpiresAt     DateTime
  updatedAt           DateTime @updatedAt
}
