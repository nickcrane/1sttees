generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The AliExpress OAuth token, singleton row (id is always "default").
// access/refresh token values are AES-256-GCM encrypted at rest (see
// lib/aliexpress/crypto.ts) -- never stored or logged in plaintext.
model AliExpressToken {
  id                    String   @id @default("default")
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt             DateTime
  refreshExpiresAt      DateTime
  updatedAt             DateTime @updatedAt
}

// -- Supplier side (raw AliExpress data) -------------------------------

enum SupplierProductStatus {
  ACTIVE
  UNAVAILABLE
  DELISTED
}

// One row per AliExpress product we've imported. `raw` keeps the full
// last-fetched aliexpress.ds.product.get payload verbatim (JSONB) so a
// field this project hasn't mapped yet is never lost, and so schema drift
// investigations have the actual response to look at.
model SupplierProduct {
  id           String                @id @default(cuid())
  aeProductId  String                @unique
  title        String
  raw          Json
  imageUrls    String[]
  supplierUrl  String?
  status       SupplierProductStatus @default(ACTIVE)
  lastSyncedAt DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  variants SupplierVariant[]

  @@index([status])
}

// One row per AliExpress SKU. `skuAttrs` is stored exactly as returned by
// aliexpress.ds.product.get -- required verbatim at order-placement time
// (aliexpress.ds.order.create), never reconstructed from parsed fields.
model SupplierVariant {
  id                 String          @id @default(cuid())
  supplierProductId  String
  supplierProduct    SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  aeSkuId            String
  skuAttrs           String
  supplierPriceMinor Int
  currency           String
  stock              Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  productVariant ProductVariant?

  @@unique([supplierProductId, aeSkuId])
}

// -- Merchandised storefront listing (independent of supplier data) ----

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// Our own listing: our title, copy, images, price -- deliberately
// independent of SupplierProduct so a supplier-side title/description
// change never touches what's shown in the storefront. One Product has
// many ProductVariants, each backed by exactly one SupplierVariant.
model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  images      String[]
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants   ProductVariant[]
  priceRules PriceRule[]

  @@index([status])
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierVariantId String          @unique
  supplierVariant   SupplierVariant @relation(fields: [supplierVariantId], references: [id])
  title             String
  priceMinor        Int
  currency          String          @default("GBP")
  images            String[]
  position          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

// -- Pricing ------------------------------------------------------------

enum PriceRuleScope {
  GLOBAL
  PRODUCT
}

enum RoundingRule {
  NONE
  PSYCHOLOGICAL_99
}

// GLOBAL rules apply store-wide (productId null); PRODUCT rules override
// for one product. See lib/pricing for how these combine.
model PriceRule {
  id               String         @id @default(cuid())
  scope            PriceRuleScope @default(GLOBAL)
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  costMultiplier   Float
  fixedUpliftMinor Int            @default(0)
  floorMarginPct   Float
  roundingRule     RoundingRule   @default(PSYCHOLOGICAL_99)
  maxPriceMinor    Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([scope, productId])
}

// -- Sync / audit ---------------------------------------------------------

model SyncRun {
  id                  String    @id @default(cuid())
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  productsScanned     Int       @default(0)
  productsUpdated     Int       @default(0)
  productsUnpublished Int       @default(0)
  errors              Json?
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

// Every admin mutation and every automated action worth a trail (Rule:
// spec requires this for admin actions and, later, automated order
// placement). `before`/`after` are partial snapshots, not full rows.
model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// -- Admin auth (separate realm from the not-yet-built customer one) ---

// Argon2id password hash, TOTP mandatory (spec: "magic link or password
// plus mandatory TOTP 2FA"). totpSecret is AES-256-GCM encrypted at rest
// via the same lib/aliexpress/crypto.ts primitives (generalized, see
// lib/crypto.ts). No admin can sign in until totpEnabledAt is set.
model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  encryptedTotpSecret String?
  totpEnabledAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  securityEvents AdminSecurityEvent[]
}

enum AdminSecurityEventType {
  SIGN_IN_SUCCESS
  SIGN_IN_FAILURE
  TOTP_ENROLLED
  TOTP_FAILURE
  SIGN_OUT
}

model AdminSecurityEvent {
  id          String                 @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser?             @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  email       String
  type        AdminSecurityEventType
  ip          String?
  createdAt   DateTime               @default(now())

  @@index([email, createdAt])
}

// -- Customer accounts (Phase 3.5) ---------------------------------------
//
// Google OAuth only -- no password, nothing to hash or leak. Model names
// (User/Account/Session/VerificationToken, and their exact field names)
// follow Auth.js's own Prisma adapter schema so @auth/prisma-adapter works
// unmodified; extending User directly with orders/addresses rather than
// keeping a separate "Customer" table avoids a redundant 1:1 join for
// every order/account lookup. Sessions are database-backed (a Session
// row per sign-in), not JWTs -- Auth.js already needs the adapter/tables
// to link a Google account to a User, so a Session table alongside them
// is effectively free, and it buys instant server-side revocation (ban a
// user, "sign out everywhere") that a JWT-only session can't do without
// extra infrastructure.
//
// Google verifies the email on our behalf (emailVerified is always set
// for a Google sign-in), which is what makes "guest orders are claimable
// by an account with the same verified email" safe: events.signIn in
// lib/customer-auth/config.ts links any existing Order rows matching the
// signed-in email (customerId still null) to this User on every sign-in.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A customer's saved shipping address book -- distinct from an Order's own
// snapshotted shippingAddress Json (spec: "editing a saved address must
// not rewrite the shipping address of a past order").
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // e.g. "Home" -- optional, user-chosen
  name      String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// -- Cart (guest, keyed by a signed cookie; customerId fills in once a
// guest cart merges into a signed-in account in Phase 3.5) --------------

model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productVariantId])
}

// -- Orders ---------------------------------------------------------------

// The full lifecycle per the mission spec's order-orchestration design.
// Phase 3 only ever produces PENDING_PAYMENT -> PAID (or leaves an order in
// PENDING_PAYMENT if an SCA challenge is abandoned) -- the rest exist now
// so the enum doesn't need a churny migration when Phase 4 builds the
// actual state machine and fulfilment queue on top of it.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  HOLD
  SUPPLIER_ORDER_QUEUED
  SUPPLIER_ORDER_PLACED
  SHIPPED
  DELIVERED
  SUPPLIER_ORDER_FAILED
  CANCELLED
  REFUNDED
  NEEDS_MANUAL_REVIEW
}

enum PaymentProviderKind {
  STRIPE
  PAYPAL
}

// Money in integer minor units throughout, never floats (project rule).
// Addresses are snapshotted as JSON directly on the order, never a live FK
// to a saved address -- spec: "editing a saved address must not rewrite
// the shipping address of a past order."
model Order {
  id                 String               @id @default(cuid())
  orderNumber        String               @unique
  customerId         String?
  customer           User?                @relation(fields: [customerId], references: [id])
  // The guest cart this order was created from -- not a relation (the Cart
  // row itself is disposable and may already be gone), just enough to find
  // and clear it once payment is confirmed. No onDelete needed since
  // there's no FK.
  cartId             String?
  email              String
  status             OrderStatus          @default(PENDING_PAYMENT)
  currency           String               @default("GBP")
  subtotalMinor      Int
  shippingMinor      Int                  @default(0)
  vatMinor           Int                  @default(0)
  vatRateBps         Int                  @default(0) // 2000 = 20%; 0 under VAT_MODE=NOT_REGISTERED
  totalMinor         Int
  shippingAddress    Json
  billingAddress     Json?
  paymentProvider    PaymentProviderKind?
  paymentProviderRef String? // Stripe PaymentIntent id / PayPal order id
  paymentMethodBrand String? // e.g. "visa" -- never PAN data (SAQ-A)
  paymentMethodLast4 String?
  paidAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items OrderItem[]

  @@unique([paymentProviderRef])
  @@index([customerId])
  @@index([email])
  @@index([status])
}

// Snapshotted at purchase time -- spec: "Snapshot price ... and supplier
// cost at the moment of purchase" -- never recomputed from the live
// ProductVariant/SupplierVariant, which can change after the order is placed.
model OrderItem {
  id                        String         @id @default(cuid())
  orderId                   String
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId          String
  productVariant            ProductVariant @relation(fields: [productVariantId], references: [id])
  titleSnapshot             String
  variantTitleSnapshot      String
  skuAttrsSnapshot          String
  unitPriceMinor            Int
  quantity                  Int
  supplierCostMinorSnapshot Int
  createdAt                 DateTime       @default(now())
}

// Raw inbound provider events, deduplicated by provider event id --
// idempotent by construction, replaying any event is a no-op (spec rule).
model WebhookEvent {
  id              String              @id @default(cuid())
  provider        PaymentProviderKind
  providerEventId String
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@unique([provider, providerEventId])
}
