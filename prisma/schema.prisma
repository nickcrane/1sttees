generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma migrate dev` has something to migrate and
// Phase 0's "hello store" page has something to read. Replaced by the real
// domain model in Phase 2.
model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}
