      "ae_item_base_info_dto": {
        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"DescriptionPerfect Size: Each tee measures 3.24 inches (83m), an ideal size for a wide range of golf balls, ensuring versatility for both practice and competitive play.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Multicolor : Comes in a vibrant multicolor pack that not only adds a touch of style to your game but also helps in easy visibility on the golf course.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Low Friction Design: The smooth surface reduces friction upon impact, providing a cleaner contact and improved ball flight for better game performance.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Premium Durability: Made from high-quality materials, these tees boast enhanced durability and resistance to wear, suitable for repeated use in all weather conditions.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"360° Flexibility: Caiton golf tees are designed with unique 360° flexibility to adjust and bend without breaking, allowing optimal setup and consistency in your game.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S0ab48bfd5d4d44478223ca0485c09cebT.jpg\",\"style\":{\"width\":3000,\"height\":3000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sdcc2b5fe5a4143b8a2ead1fe8deb24f92.jpg\",\"style\":{\"width\":3000,\"height\":3000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S7bda284a0acf493fbe3782a6d4bc39a2o.jpg\",\"style\":{\"width\":1000,\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S0250e9d7f7d24dcd8cf71c6665607a3cy.jpg\",\"style\":{\"width\":1000,\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S8dad0201094246e8aca5a85f708cc3048.jpg\",\"style\":{\"width\":1000,\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S8abcb8a47c4745989fc2c5b65b9d192a9.jpg\",\"style\":{\"width\":1000,\"height\":1000}}}]}",
        "subject": "5pcs 360° Flexible Rubber Golf Tees, 3.27in/83mm, Durable, Low Friction, Vibrant Multicolor - Ideal for Everyday Golfers",
        "evaluation_count": "203",
        "sales_count": "900+",
