      "ae_item_base_info_dto": {
        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Brand: PGM\\nMaterial: wood\\nGolf TEE Golf Tee Golf Holder\\n(Wood Tee) Specifications:\\n42mm【0.8g】; 54mm【0.9g】\\n70mm【0.9g】\",\"style\":{\"fontSize\":16,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Product Advantages\",\"style\":{\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Strong Bamboo Construction: Crafted from high-strength bamboo, these tees deliver reliable performance and help you achieve consistent shots every time you play.\\r\\n\\r\\nProtect Your Clubs: The smooth finish and natural tensile strength of bamboo minimize club marks, ensuring a clean, damage-free impact with every swing.\\r\\n\\r\\nEnhanced Accuracy and Distance: Engineered to reduce friction and side spin, these tees help optimize your shot distance and accuracy for longer, straighter drives.\\r\\n\\r\\nBright colors:Make it more fun,The color golf tees can be easily spotted after you hit.\",\"style\":{\"fontSize\":16,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sb7344f06be894952b9fa9de04c53291fY.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S3f754a106e3a48b3a7f6f756eadcfb42O.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sdbbc02a540a74612b4a0872e34e8fae7Z.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S3c7e2723b05443488f9246f63ddf2c03F.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S3064bd6a062540eb94baf9626eda74d2k.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S95580f35bf3941e98d55dd2cb752eb5cr.jpg\",\"style\":{\"width\":1000,\"height\":1000,\"paddingBottom\":10}}}]}",
