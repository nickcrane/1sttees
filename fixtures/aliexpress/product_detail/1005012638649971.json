      "ae_item_base_info_dto": {
        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"media\",\"data\":{\"mediaId\":5000585150863,\"previewImage\":\"https://ae-pic-a1.aliexpress-media.com/kf/S79dde00ca5614f69b0d70a0c95ce4fb26.jpg\",\"src\":\"https://video.aliexpress-media.com/play/u/6000732163/v/5000585150863\",\"style\":{\"width\":720,\"height\":1280}}},{\"type\":\"text\",\"data\":{\"content\":\"Description:\\nBrand: FzcSpeed\\nProduct Name: Golf Wooden Tees\\nMaterial: Natural Hardwood, Smooth Surface Without Burrs\\nSpecifications: 42mm (approx. 1 5/8\\\"), 54mm (approx. 2 1/8\\\"), 70mm (approx. 2 3/4\\\"), 83mm (approx. 3 1/4\\\")\\nColors: Assorted Colors\\nPackaging: 50 Tees per Pack\\nApplicable Scenarios: Driving Range Practice, Suitable for Irons/Woods/Hybrids\\nFeatures: Low Spin Shallow Cup Design, High Visibility Colors, Break Resistant Strengthened Treatment\\n\\n\\nFeatures:\\nProfessional Grade Durable Material: Made of high strength organic hardwood – impact resistant and break resistant, withstands repeated swings for lasting stability.\\nLow Spin Design: Shallow cup reduces contact area between the ball and tee, minimizing spin to help you achieve longer, straighter shots.\\nHigh Visibility Colors: Available in fluorescent pink, bright orange, vibrant green, and more – easy to spot on the grass, no more hunting for tees.\\nFour Height Options: Available in 42mm, 54mm, 70mm, and 83mm – suitable for drivers, irons, hybrids, and various club needs.\\n50 Pack Portable Set: Each pack includes 50 tees in a transparent self sealing bag – dust proof and easy to carry, perfect for restocking on the go.\\n\\nPacking list:\\n50*tee\\n\\n\",\"style\":{\"fontSize\":16,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S2de4489538a24d3ab539ddebb8dc34d5S.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https:/