        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Golf Bamboo Golf Tees 54mm 70mm 83mm Pack of 100 Premium Eco Friendly Sustainable Durable Bamboo Golf Tees Golf Accessories\\r\\nPACK OF 100: Contains 100 premium bamboo golf tees, fantastic value for money\\r\\nSIZE: 83mm/70mm/54mm\\r\\nECO-FRIENDLY: Made from sustainable bamboo, these tees are a green choice for environmentally conscious golfers.\\r\\nVERSATILITY: Whether you're on the tee box with a driver or a fairway wood, TH Golf's Premium Bamboo Tees offer versatility for all your clubs.\\r\\nDURABILITY: Our tees are built to last, so you can focus on your swing without worrying about constantly replacing them.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sa825407a994d45e8b0b092bc163c185f6.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sbdee9b98c5cc4cff9526a1037b7960f4f.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sbebed52c3af64da899cffa007256fcfb4.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sf541de1488c844a093a822288f15074bd.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S7bd8bf0384c94164bfbfc608c10e005f4.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S5b491c8b99214ab5b6859996fba4c66eS.jpg\",\"style\":{},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S526