        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"🌿 1000 PCS Bamboo Golf Tees – Durable, Biodegradable & Single-Size Option 🌿\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"*Choose your preferred tee length: 42mm (1-5/8\\\") / 54mm (2-1/8\\\") / 70mm (2-3/4\\\") / 83mm (3-1/4\\\") – Reduce Friction & Side Spin for a More Stable Drive*\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🏌️‍♂️ Why Choose Our Bamboo Golf Tees?\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Made from 100% natural bamboo and precision milled for consistent performance. These eco‑friendly tees are biodegradable, durable, and designed to help you play better while protecting the planet.\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🌱 Key Benefits\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"✅ 4 Length Options – Pick the exact size you need (each option = 1000 pcs of the same length)\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"✅ Reduce Friction & Side Spin – Smoother release off the tee → straighter, longer, more accurate shots\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"✅ More Stability – Consistent height and reduced ball spin keep your flight path stable\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"✅ High Durability – Strong bamboo resists breaking, even after repeated use\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"✅ Eco‑Friendly – Naturally biodegradable, no plastic waste – good for your game and the earth\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"📏 Choose Your Tee Length – Each Pack Contains 1000 pcs of ONE Size\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"🔹 42mm (1-5/8\\\")\\n→ Best for: Irons, hybrids, low-profile woods\\n→ Effect: Low tee, ideal for controlled iron shots\\n\\n🔹 54mm (2-1/8\\\")\\n→ Best for: Fairway woods, driving irons\\n→ Effect: Mid height, balanced control & distance\\n\\n🔹 70mm (2-3/4\\\")\\n→ Best for: Standard driver, practice swings\\n→ Effect: Higher launch, reduces side spin\\n\\n🔹 83mm (3-1/4\\\")\\n→ Best for: Max height driver / oversized drivers\\n→ Effect: Maximum elevation, same contact spot every time\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"All tees are natural bamboo color – no dyes, no paints. Just pure, strong bamboo.\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🎁 Package Includes (Per Option)\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🔹 1000 pcs of Bamboo Golf Tees – all the same length based on your selection\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🔹 Length options available:\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"• 42mm (1-5/8\\\") – 1000 pcs\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"• 54mm (2-1/8\\\") – 1000 pcs\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"• 70mm (2-3/4\\\") – 1000 pcs\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"• 83mm (3-1/4\\\") – 1000 pcs\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"No plastic, no toxic coatings – just pure, strong bamboo.\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🏌️‍♀️ How Bamboo Tees Improve Your Game\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Lower friction = less side spin → straighter ball flight\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Consistent tee height = repeatable swing and impact zone\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Smooth surface reduces drag, helping you gain extra yards\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Durable yet gentle on club faces (won’t scratch or mark)\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"🌍 Go Green, Play Better\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Switch from plastic or painted wood tees to 100% biodegradable bamboo. After your round, simply leave broken tees on the course – they’ll naturally decompose without harming the environment.\\n\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n\\n📦 Bulk 1000‑Pack – Perfect For\\n✔️ Avid golfers who practice daily\\n✔️ Driving ranges & golf clubs (resupply in bulk)\\n✔️ Tournaments, events, or sharing with friends\\n✔️ Eco‑conscious players reducing plastic waste\\n\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n\\n💚 100% Satisfaction Guarantee\\nIf you’re not completely happy with your bamboo tees, contact us – we’ll make it right.\\n\\nSelect your desired length and add to cart now – enjoy longer, straighter, and more sustainable drives! 🚀🏌️\\n\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n*1000 pcs Bamboo Golf Tees – Single Length Option | Choose: 42mm (1-5/8\\\") / 54mm (2-1/8\\\") / 70mm (2-3/4\\\") / 83mm (3-1/4\\\") | Biodegradable | Reduce Friction & Side Spin*\",\"style\":{}}},{\"type\":\"image\",\"data\":{\"url\":\"http://ae01.alicdn.com/kf/H7cec0e1a84a5439b8e65967c5446356fQ.jpg\",\"style\":{\"width\":1000,\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"http://ae01.alicdn.com/kf/Hbb6299ecc79f4b48a8c57b521d6919b1x.jpg\",\"style\":{\"width\":1000,\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"http://ae01.alicdn.com/kf/Ha16d180edb924983957af46932e19642l.jpg\",\"style\":{\"width\":1000,\"height\":1000}}}]}",
