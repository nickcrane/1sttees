      "ae_item_base_info_dto": {
        "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"FzcSpeed\\nProduct Name: Golf Wooden Tees\\nMaterial: Natural Hardwood, Smooth Surface Without Burrs\\nSpecifications: 42mm / 54mm /70mm /83mm\\nColors: Assorted Colors\\nPackaging: 10/20/30/50/100 Tees per Pack\\nApplicable Scenarios: Driving Range Practice, Suitable for Irons/Woods/Hybrids\\nFeatures: Low-Spin Shallow Cup Design, High-Visibility Colors, Break-Resistant Strengthened Treatment\\n\",\"style\":{\"fontSize\":16,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Product Advantages\",\"style\":{\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Professional-Grade Durable Material: Made of high-strength organic hardwood – impact-resistant and break-resistant, withstands repeated swings for lasting stability.\\r\\n\\r\\nLow-Spin Design: Shallow cup reduces contact area between the ball and tee, minimizing spin to help you achieve longer, straighter shots.\\r\\n\\r\\nHigh-Visibility Colors: Available in fluorescent pink, bright orange, vibrant green, and more – easy to spot on the grass, no more hunting for tees.\\r\\n\\r\\nFour Height Options: Available in 42mm, 54mm, 70mm, and 83mm – suitable for drivers, irons, hybrids, and various club needs.\\r\\n\\r\\nPortable Set: Transparent self-sealing bag – dust-proof and easy to carry, perfect for restocking on the go.\",\"style\":{\"fontSize\":16,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sf3f2104c3ae14eb797387520c3ce8cedF.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S3f705365abff417a82225ac424d32964Q.jpg\",\"style\":{\"width\":706,\"height\":603,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S20258d43f38f4854855e8f92cd51f058r.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sb4701ef2abaf4d0682c6c34635062b56l.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S31eafe33682540ed82c967f18915a100U.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Scde4ca25a4bd49b28a87c14dd797dc77Y.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Seda5cb5f420142a4988699076d22e234E.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sbe65c77919f944a8bbaa9e6558ec365aA.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S062d510572ea48d4af275d747da302da8.jpg\",\"style\":{\"width\":1500,\"height\":1500,\"paddingBottom\":10}}}]}",
